{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KAFKA2306/multiomics/blob/main/schema/multiomics-v1.schema.json",
  "title": "Multiomics primary-source observations",
  "type": "object",
  "required": [
    "schema_version",
    "retrieved_at",
    "sequencing_costs",
    "clinical_trials",
    "approvals",
    "sources"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "sequencing_costs": {
      "type": "array",
      "items": {"$ref": "#/$defs/sequencingCost"}
    },
    "clinical_trials": {
      "type": "array",
      "items": {"$ref": "#/$defs/clinicalTrial"}
    },
    "approvals": {
      "type": "array",
      "items": {"$ref": "#/$defs/approval"}
    },
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "sequencingCost": {
      "type": "object",
      "required": ["id", "period", "metric", "value", "unit", "source_url", "retrieved_at"],
      "properties": {
        "id": {"type": "string"},
        "period": {"type": "string", "pattern": "^[0-9]{4}(?:-[0-9]{2})?$"},
        "metric": {"enum": ["cost_per_megabase", "cost_per_genome"]},
        "value": {"type": "number", "minimum": 0},
        "unit": {"type": "string"},
        "source_url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "raw_path": {"type": "string"}
      }
    },
    "clinicalTrial": {
      "type": "object",
      "required": [
        "nct_id",
        "title",
        "status",
        "phase",
        "sponsor",
        "interventions",
        "enrollment_count",
        "enrollment_type",
        "last_update_posted",
        "source_url",
        "retrieved_at"
      ],
      "properties": {
        "nct_id": {"type": "string", "pattern": "^NCT[0-9]{8}$"},
        "title": {"type": "string"},
        "status": {"type": "string"},
        "phase": {"type": "string"},
        "sponsor": {"type": "string"},
        "interventions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "enrollment_count": {"type": "integer", "minimum": 0},
        "enrollment_type": {"type": "string"},
        "last_update_posted": {"type": "string", "format": "date"},
        "source_url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "api_data_timestamp": {"type": "string"}
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "id",
        "authority",
        "approval_date",
        "pathway",
        "generic_name",
        "brand_name",
        "sponsor",
        "modality",
        "indication",
        "source_url",
        "retrieved_at"
      ],
      "properties": {
        "id": {"type": "string"},
        "authority": {"type": "string"},
        "approval_date": {"type": "string", "format": "date"},
        "pathway": {"type": "string"},
        "generic_name": {"type": "string"},
        "brand_name": {"type": "string"},
        "sponsor": {"type": "string"},
        "modality": {"type": ["string", "null"]},
        "combination_with": {"type": "array", "items": {"type": "string"}},
        "indication": {"type": ["string", "null"]},
        "approval_summary": {"type": "string"},
        "evidence_basis": {"type": "array", "items": {"type": "string"}},
        "confirmatory_trial_required": {"type": "boolean"},
        "source_url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "raw_path": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "url", "use", "note"],
      "properties": {
        "name": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "use": {"type": "string"},
        "note": {"type": "string"}
      }
    }
  }
}
